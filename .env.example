NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/voidaccess
REDIS_URL=redis://localhost:6380
JWT_SECRET=replace-with-a-long-random-value
JWT_REFRESH_SECRET=replace-with-a-different-long-random-value
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
EMAIL_VERIFICATION_EXPIRATION=24h
INVITE_EXPIRATION=7d
APP_URL=http://localhost:3000
# RESEND_API_KEY=re_replace-with-your-resend-key
# EMAIL_FROM=voidAccess <noreply@your-verified-domain.example>
# EMAIL_OUTBOX_ENCRYPTION_KEY=base64-encoded-32-byte-key
RETENTION_TERMINAL_DAYS=30
RETENTION_AUDIT_DAYS=365
RETENTION_CLEANUP_INTERVAL=1h
TRUST_PROXY_HOPS=0
